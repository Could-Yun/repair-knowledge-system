# ============================================================
# 本地开发环境（WSL Ubuntu + 本地 PostgreSQL）
# 用法: cp .env.local .env
# ============================================================

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# ============================================================
# 数据库
# ============================================================
# 安装步骤详见 docs/DATABASE_SETUP.md
DATABASE_URL=postgresql+asyncpg://repair:CHANGE_ME@localhost:5432/repair_system
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_ECHO=false

# WSL 装了 zhparser 后这两项可以打开
ENABLE_ZHPARSER=true
FTS_CONFIG=chinese

# ============================================================
# JWT
# ============================================================
SECRET_KEY=local-dev-only-please-change-min-32chars-xxxxxxxxxx

# ============================================================
# 大模型 — 通道 1: 文本对话 (CHAT)
# ============================================================
# 推荐：DeepSeek-V3（中文强、性价比高）
# 申请: https://platform.deepseek.com/api_keys
CHAT_PROVIDER=deepseek
CHAT_API_KEY=sk-填入你的 DeepSeek key
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# ============================================================
# 大模型 — 通道 2: 多模态视觉 (VL)
# ============================================================
# 推荐：阿里 DashScope Qwen-VL-Max（视觉能力强、OpenAI 兼容端点）
# 申请: https://dashscope.console.aliyun.com/apiKey
# 注: DeepSeek-Chat 不支持视觉，必须用独立的 VL 模型
VL_PROVIDER=dashscope
VL_API_KEY=sk-填入你的 DashScope key
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-max

# ============================================================
# Embedding 后端（本地开发默认 auto；未起 llama.cpp/未配 key 时自动走 mock）
# ============================================================
EMBED_BACKEND=auto
EMBED_LOCAL_URL=http://127.0.0.1:11435/v1
EMBED_LOCAL_MODEL=bge-base-zh-v1.5
EMBED_LOCAL_KEY=local-fallback-key

# Embedding 云端兜底（llama.cpp(:11435) 不可用时启用；可与 VL_API_KEY 复用同一把 DashScope key）
EMBED_FALLBACK_PROVIDER=dashscope
EMBED_FALLBACK_API_KEY=
EMBED_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_FALLBACK_MODEL=text-embedding-v3

# ============================================================
# 大模型 — 通道 4: 本地 LLM 兜底（断网时）
# ============================================================
# 本地未启动 llama-server 时，云端失败会直接抛错（开发期可接受）
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b
LOCAL_LLM_KEY=local-fallback-key

# ============================================================
# 本地 Embedding 模型
# ============================================================
# 若未下载 BGE ONNX，EmbeddingService 会自动切换 EMBED_FALLBACK 或 mock
EMBEDDING_MODEL_PATH=./models/bge-base-zh-v1.5

# ============================================================
# 文件目录
# ============================================================
UPLOAD_DIR=./uploads
LOG_DIR=./logs
