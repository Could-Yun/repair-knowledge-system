# ============================================================
# 银河麒麟 V11 LoongArch 生产环境
# 用法: cp .env.v11 .env
# 部署步骤详见 SKILL/05-deployment.md
# ============================================================

APP_ENV=v11
APP_HOST=127.0.0.1            # 仅本机监听，由 Nginx 反代到 80/443
APP_PORT=8000

# ============================================================
# 数据库
# ============================================================
DATABASE_URL=postgresql+asyncpg://repair_user:CHANGE_ME@localhost:5432/repair_db
DB_POOL_SIZE=2                # SKILL 05 §10 内存约束
DB_MAX_OVERFLOW=3
DB_ECHO=false

# V11 上 zhparser 已源码编译并 shared_preload_libraries 加载
ENABLE_ZHPARSER=true
FTS_CONFIG=chinese

# ============================================================
# JWT
# ============================================================
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=PRODUCTION-MUST-REPLACE-WITH-RANDOM-SECRET-TOKEN

# ============================================================
# 大模型 — 通道 1: CHAT
# ============================================================
CHAT_PROVIDER=deepseek
CHAT_API_KEY=sk-生产 DeepSeek key
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# ============================================================
# 大模型 — 通道 2: VL
# ============================================================
VL_PROVIDER=dashscope
VL_API_KEY=sk-生产 DashScope key
VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_MODEL=qwen-vl-max

# ============================================================
# Embedding 后端（2026-06-02 锁定 llama.cpp 统一推理，SKILL 10/16）
# ============================================================
# auto = llama.cpp(:11435) → ONNX(可选) → DashScope → mock
EMBED_BACKEND=auto
# 由 systemd 守护：llama-server -m bge-base-zh-v1.5-q8_0.gguf --embedding --port 11435 -t 2
EMBED_LOCAL_URL=http://127.0.0.1:11435/v1
EMBED_LOCAL_MODEL=bge-base-zh-v1.5
EMBED_LOCAL_KEY=local-fallback-key

# Embedding 云端兜底（llama.cpp(:11435) 不可用时启用；SKILL 10 §1.3）
EMBED_FALLBACK_PROVIDER=dashscope
EMBED_FALLBACK_API_KEY=sk-生产 DashScope key（可与 VL 复用）
EMBED_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_FALLBACK_MODEL=text-embedding-v3

# ============================================================
# 大模型 — 通道 4: 本地 LLM 对话（systemd 守护 llama-server，chat 端口）
# ============================================================
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b
LOCAL_LLM_KEY=local-fallback-key

# ============================================================
# ONNX 备选 embedding 模型路径（仅 EMBED_BACKEND=onnx/auto 且装了 onnxruntime 时用）
# 推荐在 x86 预转好 ONNX 后上传到 /opt/models
# ============================================================
EMBEDDING_MODEL_PATH=/opt/models/bge-base-zh-v1.5

# ============================================================
# 评测/录屏前： sudo systemctl isolate multi-user.target  释放 UKUI ~1.2GB 内存
# 录屏后切回：   sudo systemctl isolate graphical.target
# ============================================================

# ============================================================
# 文件目录
# ============================================================
UPLOAD_DIR=/data/uploads
LOG_DIR=/var/log/repair-system
